# ==============================================================================
# HYDERABAD TOURIST GUIDE - ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# AI Tourist Assistant (Google Gemini or OpenAI API Key)
# If left empty, the application uses an intelligent embedded local tourist AI engine
AI_API_KEY=your-gemini-or-openai-api-key-here

# Optional: Mapbox / OpenRouteService API key for road routing (defaults to OpenStreetMap/OSRM public routing)
NEXT_PUBLIC_ORS_API_KEY=
